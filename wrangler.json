{
  "name": "arc-cctp-casefile",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "none"
  },
  "vars": {
    "LIVE_ENABLED": "false"
  },
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "CASE_IP",
      "namespace_id": "610091",
      "simple": {
        "limit": 2,
        "period": 60
      }
    },
    {
      "name": "CASE_LOCATION",
      "namespace_id": "610092",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
