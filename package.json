{
  "name": "arc-cctp-casefile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "test": "node --import tsx --test tests/casefile.test.ts tests/transport.test.ts tests/history.test.ts tests/server.test.ts tests/worker.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings src tests",
    "format": "biome format --write src tests",
    "build": "vite build && node scripts/cloudflare-assets.mjs",
    "smoke": "playwright test",
    "fixtures": "tsx tests/write-fixtures.ts",
    "build:pages": "npm run build && esbuild src/worker.ts --bundle --format=esm --target=es2022 --platform=browser --outfile=dist/_worker.js",
    "test:pages": "node --test tests/worker-artifact.test.mjs"
  },
  "dependencies": {
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "22.12.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
